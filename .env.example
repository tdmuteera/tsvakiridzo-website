# Public site URL used for canonical links, the sitemap and social metadata.
# Local development can keep the localhost value. On Vercel, set this to the
# deployment URL (and later to the custom domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where enquiry emails should be delivered. Defaults to the company email in
# src/content/company.ts when this is left empty.
ENQUIRY_TO_EMAIL=tsvakiridzo@gmail.com

# Optional SMTP delivery. Leave blank for local development: enquiries are
# saved to data/enquiries.json instead. Production on Vercel needs these
# values, or another mail setup, because the host cannot keep that file.
#
# For the company Gmail account, a normal account password will not work.
# Create a Google App Password and use smtp.gmail.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
